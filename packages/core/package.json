{
  "name": "@kamibase/core",
  "version": "0.1.0",
  "description": "Geometry graph, .kami schema, canonicalizer, validator, format parsers and SVG renderer for Kamibase.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kami.schema.json": "./schema/kami.schema.json"
  },
  "scripts": {
    "build": "pnpm run schema:emit && tsc -p tsconfig.build.json",
    "schema:emit": "tsx scripts/emit-schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "fast-xml-parser": "^4.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
