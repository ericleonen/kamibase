{"file_spec":1.2,"file_creator":"Kamibase seed script","file_author":"Kōryō Miura","file_title":"Miura-ori 4×3","file_description":"A 4×3 Miura fold — the rigid-foldable parallelogram tessellation used for deployable solar arrays and folding maps. Every interior vertex carries three creases of one kind and one of the other.","file_classes":["singleModel"],"frame_classes":["creasePattern"],"frame_attributes":["2D","manifold","orientable"],"frame_unit":"unit","vertices_coords":[[0,0],[0,0.333333333],[0,0.666666667],[0,1],[0.25,0],[0.25,0.416666667],[0.25,0.75],[0.25,1],[0.5,0],[0.5,0.333333333],[0.5,0.666666667],[0.5,1],[0.75,0],[0.75,0.416666667],[0.75,0.75],[0.75,1],[1,0],[1,0.333333333],[1,0.666666667],[1,1]],"edges_vertices":[[0,1],[0,4],[1,2],[1,5],[2,3],[2,6],[3,7],[4,5],[4,8],[5,6],[5,9],[6,7],[6,10],[7,11],[8,9],[8,12],[9,10],[9,13],[10,11],[10,14],[11,15],[12,13],[12,16],[13,14],[13,17],[14,15],[14,18],[15,19],[16,17],[17,18],[18,19]],"edges_assignment":["B","B","B","M","B","V","B","M","B","V","M","M","V","B","M","B","V","M","M","V","B","M","B","V","M","M","V","B","B","B","B"],"edges_foldAngle":[0,0,0,-180,0,180,0,-180,0,180,-180,-180,180,0,-180,0,180,-180,-180,180,0,-180,0,180,-180,-180,180,0,0,0,0],"faces_vertices":[[0,4,5,1],[1,5,6,2],[2,6,7,3],[4,8,9,5],[5,9,10,6],[6,10,11,7],[8,12,13,9],[9,13,14,10],[10,14,15,11],[12,16,17,13],[13,17,18,14],[14,18,19,15]],"kami:version":"0.1","kami:id":"01KZA5X900QF2VG70A8C17Q3DZ","kami:contentHash":"60dcbc71451c347d1a235b2413a87e90c6053a53ebe021b44c8c147138c33ada","kami:paper":{"gridSystem":"arbitrary","recommendedPaper":"Kraft or elephant hide, 80–110gsm","recommendedSizeMm":210,"shape":"square"},"kami:difficulty":{"estimatedMinutes":45,"rating":2},"kami:taxonomy":{"subject":["tessellation"],"tags":["miura","deployable","tessellation"],"techniques":["pleating","rigid-foldable"]},"kami:provenance":{"convertedFrom":{"confidence":1,"converter":"@kamibase/core parseCp","format":"cp","reviewedByHuman":true},"designer":"Kōryō Miura","originalSourceUrl":"https://en.wikipedia.org/wiki/Miura_fold"},"kami:license":{"foldingAllowed":"any","redistribution":"any","spdx":"CC0-1.0"},"kami:folding":{"collapseNotes":"Pre-crease every zigzag line first, then collapse column by column — the vertical creases change direction at each zigzag, which is what makes the fold rigid."}}
