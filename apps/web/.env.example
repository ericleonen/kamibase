# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
#
# Accounts are optional: without these the site still builds, deploys and
# serves every pattern, and the sign-in screens explain that accounts are not
# configured yet.
#
# Both values come from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects issued an "anon" key (a JWT) instead of a publishable one.
# That name is legacy but still accepted:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Both are safe in the browser — they only grant what your row-level security
# policies allow. The *secret* key (sb_secret_...) is NOT safe and must never
# appear here or in any NEXT_PUBLIC_ variable.

# Optional. Absolute URLs in Open Graph tags, and the redirect target for
# Supabase confirmation emails. Set it to your deployed URL.
# NEXT_PUBLIC_SITE_URL=https://kamibase.vercel.app

# Optional. Serve the 3D simulator from somewhere other than this deployment.
# NEXT_PUBLIC_SIMULATOR_URL=https://sim.example.com/index.html
