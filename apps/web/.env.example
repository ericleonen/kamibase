# Copy to .env.local and fill in. .env.local is gitignored. Never commit keys.
#
# Accounts are optional: without these the site still builds, deploys and
# serves every pattern, and the sign-in screens explain that accounts are not
# configured yet.
#
# Both values come from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects issued an "anon" key (a JWT) instead of a publishable one.
# That name is legacy but still accepted:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Both are safe in the browser. They only grant what your row-level security
# policies allow. The *secret* key (sb_secret_...) is NOT safe and must never
# appear here or in any NEXT_PUBLIC_ variable.

# The site's own address. Used for Open Graph tags and, more importantly, as
# the redirect target in Supabase confirmation emails.
#
# On a Vercel production deploy this is worked out automatically from the
# project's production domain, so you only need it for a custom domain or a
# non-Vercel host. Set it if a confirmation email ever points somewhere wrong.
# NEXT_PUBLIC_SITE_URL=https://kamibase-web.vercel.app
#
# Whatever this resolves to must also be listed under Supabase's
# Authentication -> URL Configuration -> Redirect URLs. Supabase silently
# substitutes the project's Site URL for any redirect it does not recognise,
# and that Site URL is http://localhost:3000 until you change it. See AUTH.md.

# Optional. Serve the 3D simulator from somewhere other than this deployment.
# NEXT_PUBLIC_SIMULATOR_URL=https://sim.example.com/index.html
